{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv sync)",
      "Bash(uv run vigil *)",
      "Bash(uv run python scripts/privacy_scan.py *)",
      "Bash(bash scripts/metadata_scan.sh *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(uv run pytest -m live *)",
      "Bash(uv run python scripts/smoke_meta.py *)",
      "Bash(uv run vigil *--confirm*)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Edit(./.env)",
      "Edit(./data/**)"
    ]
  }
}
