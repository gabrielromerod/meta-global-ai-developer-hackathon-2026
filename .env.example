# Copy to .env on the edge machine. Never commit .env (NFR-014, NFR-031).
# Meta Model API (Standard mode only; never -contributor IDs, NFR-004)
MODEL_API_KEY=
VIGIL_MODE=dev                      # dev | sandbox | edge
VIGIL_SAM_BACKEND=api               # local | api | remote (FR-042)
VIGIL_SAM_URL=                      # remote sam-worker, DGX Spark phase D-1 only
VIGIL_TRIAGE_BACKEND=spark          # glimmer | spark (FR-028)
VIGIL_GLIMMER_URL=http://127.0.0.1:8080

# Budget guard (spec 11.6)
VIGIL_TOTAL_CAP_USD=140
VIGIL_DAILY_CAP_USD=10
VIGIL_CREDIT_WINDOW_END=            # ISO-8601, e.g. 2026-11-05T05:59:00-08:00 (confirm in Credit Terms)
VIGIL_ALLOW_PAID=0                  # only you set this to 1 (NFR-037)
# VIGIL_JUDGING_END defaults to 2026-11-10T23:59:00-08:00: no live call after it, any funding
# Durable spend ledger (SQLite, WAL): caps survive restarts. Unset = in memory, and paid
# (post-window) live calls are then refused (fail closed). One process per ledger file.
VIGIL_LEDGER_PATH=data/ledger.db

# Owner (LAN) endpoints on the edge box: check-in, expected windows, spatial pairs/landmarks.
# Unset = those endpoints answer 403. Use a long random value (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))").
VIGIL_OWNER_TOKEN=
# Edge only: extra Host names allowed (JSON list). LAN and loopback IPs are always allowed.
# VIGIL_TRUSTED_HOSTS=["127.0.0.1","localhost","vigil.local"]

# Reolink cameras (spec 6). Use a unique, low-privilege user.
REOLINK_USER=
REOLINK_PASSWORD=
REOLINK_FRONT_LEFT_DUO_HOST=
REOLINK_FRONT_RIGHT_DUO_HOST=
REOLINK_DOORBELL_HOST=
REOLINK_PORCH_HOST=
REOLINK_SIDE_LEFT_HOST=
REOLINK_BACKYARD_1_HOST=
REOLINK_BACKYARD_2_HOST=
# No Home Hub: the three battery cameras use data/import/<camera_id>/ instead of hosts/streams.
# go2rtc binds WebRTC/API to this LAN address only (never 0.0.0.0 on a forwarded port)
GO2RTC_LAN_BIND=127.0.0.1
# NOTE: go2rtc substitutes ${VAR} verbatim into RTSP URLs: keep REOLINK_PASSWORD URL-safe

# Optional explicit binaries (otherwise PATH, then the WinGet Links folder)
VIGIL_FFMPEG=
VIGIL_FFPROBE=
